        "desk_lamp_arm_01",
        "desk_lamp_arm_01_light"
      ],
      "materials": {
        "desk_lamp_arm_01": {
          "swatch": "tomato",
          "flatten": 0.6,
          "roughnessBand": [
            0.4,
            0.5
          ],
          "note": "The lamp stays red: the warm accent on the imagination side, balancing the red mug on the other."
        },
        "desk_lamp_arm_01_light": {
          "swatch": "glass",
          "flatten": 0.95,
          "dropMaps": [
            "baseColor",
            "roughness",
            "normal"
          ],
          "opaque": true,
          "note": "Lamp bulb glass; kept opaque with warm bulb emission so src/props.ts fitBulb() locates the bulb mesh and attaches the desk SpotLight."
        }
      }
    },
